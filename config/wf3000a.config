# ==========================================================================
# 项目 2 / 3 —— KST WF3000A（expand 114m 大分区）
#
# 源码：wangwang623/immortalwrt-mt798x（ImmortalWrt 21.02 / Linux 5.4，MTK 闭源驱动）
# 包集合：与 config/ax3000t.config 逐行一致（同为 MT7981），基线同为 hkint 原版
#   .config，仅去掉 网速控制 / UPnP / 文件传输 3 类；Argon 主题保留，其余不变。
#   保留 Argon 主题（+wget / jsonfilter）、网络加速 turboacc-mtk、bootstrap-mod、
#   zram-swap、闭源驱动全套、系统完整功能与中文环境；补齐 6 项。
#
# 非包符号块：MT7981 芯片符号与 ax3000t 一致；机型改为单一 kst_wf3000a，
#   并启用 CONFIG_TARGET_ROOTFS_INITRAMFS（先用内存启动验有线网口）。
#   DTS / 02_network 采用「6.6 已验证硬件事实 + 5.4 cetron,ct3003 单 GMAC+VLAN」
#   组合，不照抄 NL-WR8103 的外置 PHY / 双 GMAC 写法。
#
# 依赖不手写，make defconfig 沿依赖树自动展开；末尾有显式 is not set 禁用块。
# ==========================================================================
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_mt7981=y
CONFIG_TARGET_MULTI_PROFILE=y
# 只编 1 个机型：KST WF3000A，expand(114m) 布局
CONFIG_TARGET_DEVICE_mediatek_mt7981_DEVICE_kst_wf3000a=y
CONFIG_TARGET_DEVICE_PACKAGES_mediatek_mt7981_DEVICE_kst_wf3000a=""
# 产物含 initramfs-kernel.bin：先内存启动验证，再刷 factory.bin
CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_DEVEL=y
CONFIG_TOOLCHAINOPTS=y
CONFIG_BUSYBOX_CUSTOM=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y
CONFIG_AFALG_UPDATE_CTR_IV=y
CONFIG_BUSYBOX_CONFIG_BLKID=y
CONFIG_BUSYBOX_CONFIG_FEATURE_BLKID_TYPE=y
CONFIG_BUSYBOX_CONFIG_VOLUMEID=y
CONFIG_CONNINFRA_AUTO_UP=y
CONFIG_CONNINFRA_EMI_SUPPORT=y
# CONFIG_GDB is not set
CONFIG_INCLUDE_CONFIG=y
CONFIG_JSON_OVERVIEW_IMAGE_INFO=y
# CONFIG_KERNEL_BLK_DEV_THROTTLING is not set
# CONFIG_KERNEL_CFS_BANDWIDTH is not set
CONFIG_KERNEL_CGROUP_DEVICE=y
CONFIG_KERNEL_CGROUP_FREEZER=y
CONFIG_KERNEL_DEVMEM=y
# CONFIG_KERNEL_KEYS is not set
# CONFIG_KERNEL_MEMCG_SWAP is not set
CONFIG_KERNEL_NET_CLS_CGROUP=y
