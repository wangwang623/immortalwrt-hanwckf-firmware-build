# ── 闭源无线驱动（MTK，5.4 源码自带；三个机型统一）──────────────
# 这份源码没有开源 mt76；无线完全靠下面这组包，缺一即无 WiFi。
CONFIG_PACKAGE_kmod-mt_wifi=y
CONFIG_PACKAGE_kmod-warp=y
CONFIG_PACKAGE_kmod-conninfra=y
CONFIG_PACKAGE_wifi-dats=y
CONFIG_PACKAGE_mtwifi-cfg=y
CONFIG_PACKAGE_datconf=y
CONFIG_PACKAGE_datconf-lua=y
CONFIG_PACKAGE_kvcedit=y
CONFIG_PACKAGE_libkvcutil=y
CONFIG_PACKAGE_luci-app-mtwifi-cfg=y
CONFIG_PACKAGE_luci-i18n-mtwifi-cfg-zh-cn=y
CONFIG_PACKAGE_iw=y
CONFIG_PACKAGE_iwinfo=y

# ── HNAT 硬件加速（kmod-mt_wifi 的硬依赖）─────────────────────
CONFIG_PACKAGE_kmod-mediatek_hnat=y

# ── LuCI 基础 + 中文 + 基础网络 ────────────────────────────────
CONFIG_PACKAGE_luci=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_opkg=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y

# ── 内核绑定组件：zram-swap ───────────────────────────────────
# kmod-zram 与内核 vermagic 强绑定，必须编进固件，不能事后 opkg install。
# 默认 64M + lzo 由 scripts/*.sh 注入的 uci-defaults 固化，LuCI 里可改。
# lzo / lz4 两个算法模块都编入：LuCI 下拉里选任一个都能真正生效，
# 不出现「能选却不生效」；lz4hc / zstd 按最小系统口径不编。
CONFIG_PACKAGE_kmod-zram=y
CONFIG_PACKAGE_kmod-lib-lzo=y
CONFIG_PACKAGE_kmod-lib-lz4=y
CONFIG_PACKAGE_zram-swap=y

# ── 保留的 MTK 实用插件：网络加速（hkint 原版保留项）──────────
# 页面在「网络 → 网络加速」：HNAT / PPE / WED、IPv6 HNAT、MACVLAN、
# 全锥形 NAT、TCP 拥塞算法等可调项。驱动 kmod-mediatek_hnat 已在上方闭源段，
# 这里只是配置界面；删掉它 HNAT 仍默认加载，但没有任何可调入口。
CONFIG_PACKAGE_luci-app-turboacc-mtk=y
CONFIG_PACKAGE_luci-i18n-turboacc-mtk-zh-cn=y

# ── 系统本身完整功能（原工程 617 行 .config 恢复，非插件）──────
